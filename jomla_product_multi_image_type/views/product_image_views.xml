<odoo>
    <record id="view_product_image_type_form" model="ir.ui.view">
        <field name="name">view.product.image.type.form</field>
        <field name="model">product.image</field>
        <field name="inherit_id" ref="product_multi_image.view_product_image_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='video_url']/.." position="after">
                <group>
                    <group>
                        <field name="type"/>
                    </group>
                    <group/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>