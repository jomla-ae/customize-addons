<odoo>
    <record id="view_product_status_product_category_filter" model="ir.ui.view">
        <field name="name">view.product.status.product.category.filter</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="Status" domain="[]" context="{'group_by':'state'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_status_product_category_tree" model="ir.ui.view">
        <field name="name">view.product.status.product.category.tree</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="state" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_status_product_category_form" model="ir.ui.view">
        <field name="name">view.product.status.product.category.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_submit" string="Submit" type="object" states="draft" class="oe_highlight"
                            groups="stock.group_stock_manager"/>
                    <button name="action_approve" string="Approve" type="object" states="to_reviewed"
                            class="oe_highlight" groups="stock.group_stock_manager"/>
                    <button name="action_publish" string="Publish" type="object" states="approved" class="oe_highlight"
                            groups="stock.group_stock_manager"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            states="to_reviewed,approved,published" class="oe_highlight"
                            groups="stock.group_stock_manager"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,to_reviewed,approved,published"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="action_submit_product_category_server" model="ir.actions.server">
        <field name="name">Submit</field>
        <field name="model_id" ref="product.model_product_category"/>
        <field name="binding_model_id" ref="product.model_product_category"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_submit()</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_manager'))]"/>
    </record>

    <record id="action_approve_product_category_server" model="ir.actions.server">
        <field name="name">Approve</field>
        <field name="model_id" ref="product.model_product_category"/>
        <field name="binding_model_id" ref="product.model_product_category"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_approve()</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_manager'))]"/>
    </record>

    <record id="action_publish_product_category_server" model="ir.actions.server">
        <field name="name">Publish</field>
        <field name="model_id" ref="product.model_product_category"/>
        <field name="binding_model_id" ref="product.model_product_category"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_publish()</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_manager'))]"/>
    </record>

    <record id="action_reset_to_draft_product_category_server" model="ir.actions.server">
        <field name="name">Reset to Draft</field>
        <field name="model_id" ref="product.model_product_category"/>
        <field name="binding_model_id" ref="product.model_product_category"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_reset_to_draft()</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_manager'))]"/>
    </record>
</odoo>