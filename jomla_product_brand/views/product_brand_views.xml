<odoo>
    <record id="view_product_brand_tree" model="ir.ui.view">
        <field name="name">view.product.brand.tree</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <tree string="Product Brand">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_product_brand_form" model="ir.ui.view">
        <field name="name">view.product.brand.form</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <form string="Product Brand">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" string="Brand Name"/>
                        <h1>
                            <div class="d-flex">
                                <field class="text-break" name="name"/>
                            </div>
                        </h1>
                    </div>

                    <group>
                        <field name="description"/>
                    </group>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_product_brands" model="ir.actions.act_window">
        <field name="name">Product Brands</field>
        <field name="res_model">product.brand</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_product_brands" name="Product Brands" parent="stock.menu_product_in_config_stock"
              action="action_product_brands" sequence="3"/>
</odoo>