<odoo>
    <record id="view_product_brand_product_template_only_filter" model="ir.ui.view">
        <field name="name">view.product.brand.product.template.only.filter</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="brand_id"/>
            </xpath>

            <xpath expr="//filter[@name='categ_id']" position="after">
                <separator/>
                <filter name="group_by_brand_id" string="Brand" domain="[]" context="{'group_by':'brand_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_brand_product_template_only_tree" model="ir.ui.view">
        <field name="name">view.product.brand.product.template.only.tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="brand_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_brand_product_template_form" model="ir.ui.view">
        <field name="name">view.product.brand.product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="brand_id"/>
            </xpath>
        </field>
    </record>
</odoo>