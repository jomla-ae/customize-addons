<odoo>
    <record id="view_product_multi_image_product_template_form" model="ir.ui.view">
        <field name="name">view.product.multi.image.product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']/group[@name='sale']" position="inside">
                <group name="product_template_images" string="Extra Product Media"
                       attrs="{'invisible': [('sale_ok','=',False)]}">
                    <field name="product_template_image_ids" class="o_product_image_list"
                           context="{'default_name': name}" mode="kanban" add-label="Add a Media" nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>